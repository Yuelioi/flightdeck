#!/usr/bin/env bash
# Stop hook for flightdeck: silently regenerate the board AUTO regions
# (cockpit ## In Progress + each INDEX.md AUTO region) at end-of-turn. Passive
# only — never decision:block, never archive, never touch judgment fields.
set -uo pipefail

# Opt-in diagnostics (FLIGHTDECK_HOOK_DEBUG=1) — default silent.
dbg() { [ -n "${FLIGHTDECK_HOOK_DEBUG:-}" ] && printf 'flightdeck-hook[%s]: %s\n' "$(basename "$0")" "$1" >&2 || true; }

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
# shellcheck source=/dev/null
. "${SCRIPT_DIR}/_context.sh"
PROJECT_DIR="${CLAUDE_PROJECT_DIR:-${CURSOR_PROJECT_ROOT:-${GEMINI_PROJECT_DIR:-$PWD}}}"
dbg "project-dir = ${PROJECT_DIR}"

# Gate: no deck → nothing to sync.
if [ ! -d "${PROJECT_DIR}/flightdeck" ]; then
  dbg "gate: no deck at ${PROJECT_DIR}/flightdeck — exit"
  exit 0
fi

# Cursor's stable-loading primary path: refresh the always-applied rule file at
# turn end so the next turn loads a current cockpit anchor. Independent of the
# python board-sync below (no interpreter needed to read cockpit + bootstrap).
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ] || [ -n "${CURSOR_PROJECT_ROOT:-}" ]; then
  cursor_ctx="$(build_context "$PROJECT_DIR" "$PLUGIN_ROOT")" || cursor_ctx=""
  if [ -n "$cursor_ctx" ]; then
    dbg "cursor: refresh .cursor/rules/flightdeck-context.mdc"
    write_cursor_rules "$PROJECT_DIR" "$cursor_ctx"
  fi
fi

# Locate a *working* python runtime; degrade silently if none. The viability
# probe (`-c ''`) is load-bearing on Windows: `command -v python3` resolves to
# the Microsoft Store stub (exits 49, never runs Python), so a plain presence
# check would pick it and board-sync would silently no-op. Skip any interpreter
# that can't execute, falling through to the real one (e.g. the `py` launcher).
PY=""
for c in python3 python py; do
  if command -v "$c" >/dev/null 2>&1 && "$c" -c '' >/dev/null 2>&1; then PY="$c"; break; fi
done
if [ -z "$PY" ]; then dbg "no working python — exit"; exit 0; fi
dbg "python = ${PY}"

index_py="${PLUGIN_ROOT}/scripts/flightdeck_index.py"
if [ ! -f "$index_py" ]; then dbg "missing ${index_py} — exit"; exit 0; fi

# Regenerate AUTO regions; swallow all output (passive, idempotent).
dbg "regen board: ${PROJECT_DIR}/flightdeck"
"$PY" "$index_py" "${PROJECT_DIR}/flightdeck" >/dev/null 2>&1 || true
exit 0
