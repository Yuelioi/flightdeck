#!/usr/bin/env bash
# SessionStart hook for flightdeck: inject the bootstrap directive + a live
# cockpit anchor so the agent enters in preflight-handoff mode from turn 0.
# Never errors out — degrades to silence (manual preflight still works).
set -uo pipefail

# Opt-in diagnostics (FLIGHTDECK_HOOK_DEBUG=1) — default silent.
dbg() { [ -n "${FLIGHTDECK_HOOK_DEBUG:-}" ] && printf 'flightdeck-hook[%s]: %s\n' "$(basename "$0")" "$1" >&2 || true; }

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
# shellcheck source=/dev/null
. "${SCRIPT_DIR}/_context.sh"

# Resolve the project dir the hook is running against. Single host signal each,
# then $PWD fallback; the deck gate below never walks up to a parent directory.
# (Codex has no dedicated env var here — it rides $PWD; verified live in Phase 4.)
PROJECT_DIR="${CLAUDE_PROJECT_DIR:-${CURSOR_PROJECT_ROOT:-${GEMINI_PROJECT_DIR:-$PWD}}}"
dbg "project-dir = ${PROJECT_DIR}"

emit() {
  # $1 = the context string (already the final injected text)
  local ctx; ctx="$(escape_for_json "$1")"
  if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
    printf '{\n  "additional_context": "%s"\n}\n' "$ctx"
  elif [ -n "${CODEX_PLUGIN_ROOT:-}" ] || [ -n "${GEMINI_PROJECT_DIR:-}" ] \
       || { [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; }; then
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$ctx"
  else
    printf '{\n  "additionalContext": "%s"\n}\n' "$ctx"
  fi
}

# Gate: no deck here → say nothing.
if [ ! -d "${PROJECT_DIR}/flightdeck" ]; then
  dbg "gate: no deck at ${PROJECT_DIR}/flightdeck — emit {}"
  printf '{}\n'
  exit 0
fi

# Assemble bootstrap directive + live cockpit anchor (shared with stop).
content="$(build_context "$PROJECT_DIR" "$PLUGIN_ROOT")" || content=""
if [ -z "$content" ]; then
  dbg "no bootstrap content — emit {}"
  printf '{}\n'
  exit 0
fi

# Cursor's stable-loading primary path: write the always-applied rule file.
# (Still emit additional_context below as belt-and-suspenders, not the main dep.)
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ] || [ -n "${CURSOR_PROJECT_ROOT:-}" ]; then
  dbg "cursor: write .cursor/rules/flightdeck-context.mdc"
  write_cursor_rules "$PROJECT_DIR" "$content"
fi

emit "$content"
exit 0
